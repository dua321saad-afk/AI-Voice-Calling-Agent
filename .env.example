# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_DEBUG=false

# Admin dashboard login (also gates the /agent page). CHANGE before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Groq LLM (free tier -> https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Database (SQLite - no external DB needed)
DATABASE_FILE=database.db

# Server port (Render/Railway set this automatically)
PORT=5000

# Only needed if you deploy this publicly and want links to resolve correctly.
# Not required for local/laptop-only use - the agent runs in the browser.
BASE_URL=http://localhost:5000
